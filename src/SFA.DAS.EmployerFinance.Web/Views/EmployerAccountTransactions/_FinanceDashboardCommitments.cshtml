@using System.Globalization

@model FinanceDashboardV2ViewModel
@{
    var culture = new CultureInfo("en-GB");
}
<div class="govuk-grid-row govuk-!-margin-top-6">
    <div class="govuk-grid-column-three-quarters">
        <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Commitments</h3>
        <p class="govuk-body govuk-!-margin-top-0 govuk-!-margin-bottom-2">
            Paid from your levy funds in monthly instalments until learners complete their training. These totals reduce over time as payments are made.
        </p>
        <div class="app-finance-figure-no-border app-finance-figure--row govuk-!-margin-bottom-2">
            <div class="app-finance-figure-commitments__label">
                <strong class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-0 govuk-!-font-size-16">Learner costs</strong>
                <p class="govuk-body govuk-!-margin-bottom-0 govuk-!-margin-top-0 govuk-!-font-size-16 govuk-hint">
                    Total levy funds committed to spend on your learners.
                </p>
            </div>
            <span class="govuk-body govuk-!-font-size-19 app-finance-figure__value">
                @Model.TotalCommittedLearnerCosts.ToString("C0", culture)
            </span>
        </div>
        <div class="app-finance-figure-no-border app-finance-figure--row">
            <div class="app-finance-figure-commitments__label">
                <strong class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-0 govuk-!-font-size-16">Transfer costs</strong>
                <p class="govuk-body govuk-!-margin-bottom-0 govuk-!-margin-top-0 govuk-!-font-size-16 govuk-hint">
                    Total levy funds committed to other employers.
                </p>
            </div>
            <span class="govuk-body govuk-!-font-size-19 app-finance-figure__value">
                @Model.TotalCommittedTransfersCosts.ToString("C0", culture)
            </span>
        </div>
    </div>
</div>
