@using System.Globalization

@model EstimatesViewModel
@{
    var culture = new CultureInfo("en-GB");
}
<div class="govuk-body">
    <p>This timeline is based on your current funds and commitments. The figures are estimates and are not final.</p>
    <p class="govuk-!-margin-bottom-8">Levy in is estimated using your declaration for the same month last year. Levy out is estimated on information currently recorded in your account. This may change if learner or funding details are updated, including breaks in learning or withdrawals.</p>
    
    @if (!Model.HasProjection)
    {
        <a href="@Url.RouteUrl(RouteNames.FinanceIndex, new { hashedAccountId = Model.HashedAccountId })#finance-estimates"
           role="button" draggable="false" class="govuk-button govuk-!-margin-bottom-0 app-js-hidden" data-module="govuk-button">Add timeline</a>
    }
    else
    {
        if (Model.ShowCoInvestmentBanner)
        {
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-three-quarters">
                    <div class="govuk-inset-text app-finance-figure-no-border govuk-!-margin-bottom-8">
                        <p><strong>You may enter co-investment in @Model.CoInvestmentStartLabel.</strong> Depending on when learners started, you will pay up to 25% of learner costs until your levy funds cover them.</p>
                    </div>
                </div>
            </div>
        }

        if (Model.MonthEstimates.Any())
        {
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-three-quarters">
                    <div class="govuk-!-margin-bottom-6 app-flex-row-space-between">
                        <a href="@Url.RouteUrl(RouteNames.FinanceIndex, new { hashedAccountId = Model.HashedAccountId })#finance-estimates"
                           role="button" draggable="false" class="govuk-button govuk-!-margin-bottom-0 app-js-hidden" data-module="govuk-button">Refresh timeline</a>
                        <p class="govuk-hint govuk-!-margin-bottom-0 govuk-!-font-size-16">@Model.LastUpdatedUtcLabel</p>
                    </div>
                    @foreach (var month in Model.MonthEstimates)
                    {
                        <estimates-row text="@month.Period" provisional=@(month == Model.MonthEstimates.First())>
                            <estimates-month-card balance="@month.ClosingLevyBalance.ToString("C0", culture)" class="govuk-!-margin-bottom-4">
                                <line-item text="Levy in" value="@month.LevyIn.ToString("C0", culture)" />
                                <line-item text="Levy out" value="@month.LevyOut.ToString("C0", culture)">
                                    <sub-item text="Learner costs" value="@month.CommittedLearnerCosts.ToString("C0", culture)" />
                                    <sub-item text="Completion payments" value="@month.CommittedLearnerFinalPaymentCost.ToString("C0", culture)" />
                                    <sub-item text="Transfer costs" value="@month.CommittedTransferCosts.ToString("C0", culture)" />
                                    <sub-item text="Expired levy" value="@month.ExpiredLevy.ToString("C0", culture)" />
                                </line-item>

                                @if (month.InCoInvestment)
                                {
                                    <hr class="govuk-section-break govuk-section-break--visible"/>
                                    <line-item text="Co-investment payments" value="@month.CoInvestmentTotal.ToString("C0", culture)">
                                        <sub-item text="Government contribution" value="@month.DfeCoInvestmentCost.ToString("C0", culture)"/>
                                        <sub-item text="Your payment" value="@month.CoInvestmentCosts!.Value.ToString("C0", culture)"/>
                                    </line-item>
                                }   

                            </estimates-month-card>
                        </estimates-row>
                    }
                </div>
            </div>
        }
    }
</div>