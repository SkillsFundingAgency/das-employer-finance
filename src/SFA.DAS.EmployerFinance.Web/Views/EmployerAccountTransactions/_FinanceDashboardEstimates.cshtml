@model EstimatesViewModel

<div class="govuk-body">

    <p class="govuk-!-margin-bottom-8">This timeline shows estimated payments based on your current funds and commitments. These payments may change and do not include future breaks in learning.</p>

    @if (Model is not { MonthEstimates: { Count: > 0 } })
    {
        return;
    }

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-three-quarters">
            <div class="govuk-!-margin-bottom-4">Updated at @($"{Model.LastUpdatedUtc.ToGmtStandardTime().ToGdsTimeFormatFull()} on {Model.LastUpdatedUtc.ToGmtStandardTime().ToGdsFormatFull()}")</div>
            @foreach (var month in Model.MonthEstimates)
            {
                <estimates-row text="@month.Period" provisional=@(month == Model.MonthEstimates.First())>
                    <estimates-month-card balance="@month.ClosingBalance.ToString("C0")" class="govuk-!-margin-bottom-4">
                        <line-item text="Levy in" value="@month.LevyIn.ToString("C0")"/>
                        <line-item text="Levy out" value="@month.LevyOut.ToString("C0")">
                            <sub-item text="Expired levy" value="@month.ExpiredLevy.ToString("C0")"/>
                            <sub-item text="Commited learner costs" value="@month.CommittedLearnerCosts.ToString("C0")"/>
                            <sub-item text="Commited transfer costs" value="@month.CommittedLearnerCosts.ToString("C0")"/>
                        </line-item>
                    </estimates-month-card>
                </estimates-row>
            }
        </div>
    </div>
</div>